rules_version = '2';

// ===============================================================
// Assumed Data Model & Architecture
// ===============================================================
//
// 1. /stats/totals and /stats_daily/{day}
//    - Public anonymous usage counters incremented boundedly.
//
// 2. /enquiries/{id}
//    - Public contact enquiries submitted via business lead forms.
//    - Fields: name, email, phone, message, page, createdAt.
//    - Read/manage restricted to owner (mannarmannan0@gmail.com).
//
// 3. /subscriptions/{deviceId}
//    - Device-bound active subscription records for Label Crop AI Pro.
//    - Document ID: deviceId (string)
//    - Fields:
//      * deviceId: string (required, matches document ID)
//      * isPro: bool (required)
//      * planId: string (optional)
//      * planTitle: string (optional)
//      * amount: number (required, > 0 and <= 10000)
//      * currency: string (optional)
//      * paymentId: string (required, size >= 5)
//      * orderId: string (optional)
//      * customerPhone: string (optional)
//      * customerEmail: string (optional)
//      * purchaseTime: number (optional)
//      * expiryTime: number (required)
//      * durationDays: number (optional)
//      * platform: string (optional)
//      * updatedAt: number or timestamp (optional)
//    - Read: public (device queries its active subscription status before purchase)
//    - Create/Update: validated strict schema, deviceId consistency, price bounds
//    - Delete: owner only
//
// 4. /payments/{paymentId}
//    - Sensitive financial audit ledger of completed Razorpay transactions.
//    - Document ID: paymentId (string, size >= 5)
//    - Fields:
//      * paymentId: string (required, matches document ID, size >= 5)
//      * amount: number (required, > 0)
//      * deviceId, planId, currency, orderId, customerPhone, customerEmail,
//        purchaseTime, expiryTime, status, platform, createdAt (optional)
//    - Read: owner only (mannarmannan0@gmail.com)
//    - Create: validated strict schema, immutable ledger
//    - Update: strictly false (immutable financial ledger)
//    - Delete: owner only
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // The private dashboard at /admin. Add more addresses here to share access.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ["mannarmannan0@gmail.com"];
    }

    function delta(field) {
      return request.resource.data.get(field, 0) - (resource != null ? resource.data.get(field, 0) : 0);
    }

    function bounded(field, max) {
      return delta(field) >= 0 && delta(field) <= max;
    }

    function validCounters() {
      return request.resource.data.v == 1
        && request.resource.data.keys().hasOnly(['v', 'updatedAt', 'uploads', 'files', 'pages',
             'labels', 'invoices', 'downloads', 'shares', 'meesho', 'flipkart', 'amazon', 'other'])
        && bounded('uploads', 10) && bounded('files', 200) && bounded('pages', 20000)
        && bounded('labels', 20000) && bounded('invoices', 20000) && bounded('downloads', 50) && bounded('shares', 50)
        && bounded('meesho', 10) && bounded('flipkart', 10) && bounded('amazon', 10) && bounded('other', 10);
    }

    match /stats/totals {
      allow read: if true;
      allow create, update: if validCounters();
      allow delete: if false;
    }

    match /stats_daily/{day} {
      allow read: if true;
      allow create, update: if validCounters() && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow delete: if false;
    }

    // Business enquiries from the "I want software for my business" form.
    // Anyone may submit one; only an owner (see isOwner) can read, mark handled
    // or delete them, through the private dashboard at /admin.
    match /enquiries/{id} {
      function text(field, max) {
        return request.resource.data.get(field, "") is string
          && request.resource.data.get(field, "").size() <= max;
      }
      allow create: if request.resource.data.keys().hasOnly(["name", "email", "phone", "message", "page", "createdAt"])
        && text("name", 80) && text("email", 120) && text("phone", 25)
        && text("message", 2000) && text("page", 120)
        && request.resource.data.get("message", "").size() >= 5
        && (request.resource.data.get("email", "").size() >= 5 || request.resource.data.get("phone", "").size() >= 7);
      allow read, update, delete: if isOwner();
    }

    // Device subscription status for Pro features (Razorpay).
    // Devices check active subscription status before purchase.
    match /subscriptions/{deviceId} {
      allow read: if true;
      allow create, update: if request.resource.data.deviceId == deviceId
        && request.resource.data.keys().hasOnly(['deviceId', 'isPro', 'planId', 'planTitle', 'amount', 'currency', 'paymentId', 'orderId', 'customerPhone', 'customerEmail', 'purchaseTime', 'expiryTime', 'durationDays', 'platform', 'updatedAt'])
        && request.resource.data.isPro is bool
        && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 10000
        && request.resource.data.expiryTime is number
        && request.resource.data.paymentId is string && request.resource.data.paymentId.size() >= 5;
      allow delete: if isOwner();
    }

    // Financial transaction logs for Razorpay payments.
    // Read and delete restricted to admin owner; writes validated and updates strictly disabled.
    match /payments/{paymentId} {
      allow read: if isOwner();
      allow create: if request.resource.data.paymentId == paymentId
        && request.resource.data.paymentId.size() >= 5
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.keys().hasOnly(['paymentId', 'deviceId', 'planId', 'amount', 'currency', 'orderId', 'customerPhone', 'customerEmail', 'purchaseTime', 'expiryTime', 'status', 'platform', 'createdAt']);
      allow update: if false;
      allow delete: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
