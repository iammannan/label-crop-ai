{
  "name": "label-crop-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Label Crop AI - free in-browser Flipkart, Meesho & Amazon shipping label crop tool.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "emulate": "node scripts/build.mjs && firebase emulators:start --only hosting --project demo-label-crop-ai",
    "test": "node scripts/build.mjs && node scripts/e2e.mjs",
    "deploy": "node scripts/build.mjs && firebase deploy --only hosting",
    "indexnow": "node scripts/indexnow.mjs",
    "seo-audit": "node scripts/seo-audit.mjs"
  },
  "devDependencies": {
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "puppeteer-core": "^24.0.0"
  }
}
